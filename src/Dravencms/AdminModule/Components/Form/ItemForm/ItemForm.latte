<form n:name="form" class="card">
    <ul class="alert alert-danger" n:if="$form->hasErrors()">
        <li n:foreach="$form->errors as $error">{$error}</li>
    </ul>
    <div class="card-body">
        <ul class="nav nav-tabs" role="tablist">
            <li n:foreach="$activeLocales as $activeLocale" role="presentation" class="nav-item"><a n:class="$activeLocale->isDefault() ? active, nav-link" href="#{$activeLocale->getLanguageCode()}" aria-controls="home"
                                                                                                                                 role="tab" data-bs-toggle="tab"><span
                            class="flag-icon flag-icon-{$activeLocale->getCountry()->getCode()|lower}"></span> {$activeLocale->getName()}</a></li>
        </ul>
        <div class="tab-content">
            <div n:foreach="$activeLocales as $activeLocale" role="tabpanel" n:class="$activeLocale->isDefault() ? active, tab-pane" id="{$activeLocale->getLanguageCode()}">
                {formContainer $activeLocale->getLanguageCode()}
                    <fieldset>
                        <legend>{$activeLocale->getName()}</legend>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="mb-3">
                                    <label class="form-label" n:name="title">{_"form.item.title"}</label>
                                    <input n:name="title" class="form-control">
                                </div>
                            </div><!-- col-sm-6 -->
                            <div class="col-sm-6">
                                <div class="mb-3">
                                    <label class="form-label" n:name="placeholder">{_"form.item.placeholder"}</label>
                                    <input n:name="placeholder" class="form-control">
                                </div>
                            </div><!-- col-sm-6 -->
                        </div><!-- row -->
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="mb-3">
                                    <label class="form-label" n:name="defaultValue">{_"form.item.defaultValue"}</label>
                                    <input n:name="defaultValue" class="form-control">
                                </div>
                            </div><!-- col-sm-6 -->
                            <div class="col-sm-6">
                                <div class="mb-3">
                                    <label class="form-label" n:name="required">{_"form.item.required"}</label>
                                    <input n:name="required" class="form-control">
                                </div>
                            </div><!-- col-sm-6 -->
                        </div><!-- row -->
                    </fieldset>
                {/formContainer}
            </div>
        </div>

        <div class="row">
            <div class="col-sm-6">
                <div class="mb-3">
                    <label class="form-label" n:name="name">{_"form.item.name"}</label>
                    <input type="text" n:name="name" autofocus="autofocus" class="form-control">
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-6">
                <div class="mb-3">
                    <label class="form-label" n:name="type">{_"form.item.type"}</label>
                    <select n:name="type" class="form-control"></select>
                </div>
            </div><!-- col-sm-6 -->
            <div class="col-sm-6">
                <div class="mb-3">
                    <label class="form-label" n:name="position">{_"form.item.position"}</label>
                    <input n:name="position" class="form-control">
                </div>
            </div><!-- col-sm-6 -->
        </div><!-- row -->


        <div class="row">
            <div class="col-sm-6">
                <div class="mb-3">
                    <label class="form-label" n:name="maxValue">{_"form.item.maxValue"}</label>
                    <input n:name="maxValue" class="form-control">
                </div>
            </div><!-- col-sm-6 -->
            <div class="col-sm-6">
                <div class="mb-3">
                    <label class="form-label" n:name="minValue">{_"form.item.minValue"}</label>
                    <input n:name="minValue" class="form-control">
                </div>
            </div><!-- col-sm-6 -->
        </div><!-- row -->

    </div>
    <div class="card-footer">
        <input type="submit" n:name="send" class="btn btn-success button" value="{_"form.global.save"}">
    </div>
</form>