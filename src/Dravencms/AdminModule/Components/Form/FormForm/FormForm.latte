<form n:name="form" class="card">
    <ul class="alert alert-danger" n:if="$form->hasErrors()">
        <li n:foreach="$form->errors as $error">{$error}</li>
    </ul>
    <div class="card-body">
        <ul class="nav nav-tabs" role="tablist">
            <li n:foreach="$activeLocales as $activeLocale" role="presentation" class="nav-item"><a n:class="$activeLocale->isDefault() ? active, nav-link" href="#{$activeLocale->getLanguageCode()}" aria-controls="home"
                                                                                                                                 role="tab" data-bs-toggle="tab"><span
                            class="flag-icon flag-icon-{$activeLocale->getCountry()->getCode()|lower}"></span> {$activeLocale->getName()}</a></li>
        </ul>
        <div class="tab-content">
            <div n:foreach="$activeLocales as $activeLocale" role="tabpanel" n:class="$activeLocale->isDefault() ? active, tab-pane" id="{$activeLocale->getLanguageCode()}">
                {formContainer $activeLocale->getLanguageCode()}
                    <fieldset>
                        <legend>{$activeLocale->getName()}</legend>

                        <div class="row">
                            <div class="col-sm-12">
                                <div class="mb-3">
                                    <label class="form-label" n:name="sendButtonValue">{_"form.form.sendButtonText"}</label>
                                    <input n:name="sendButtonValue" class="form-control">
                                </div>
                            </div><!-- col-sm-12 -->
                        </div><!-- row -->

                        <div class="row">
                            <div class="col-sm-12">
                                <div class="mb-3">
                                    <label class="form-label" n:name="successMessage">{_"form.form.successMessage"}</label>
                                    <textarea n:name="successMessage" class="form-control"></textarea>
                                </div>
                            </div><!-- col-sm-12 -->
                        </div><!-- row -->

                        <div class="row">
                            <div class="col-sm-12">
                                <div class="mb-3">
                                    <label class="form-label" n:name="latteTemplate">{_"form.form.latteTemplate"}</label>
                                    <textarea n:name="latteTemplate" class="form-control codemirror" data-codemirror-mode="htmlmixed"></textarea>
                                </div>
                            </div><!-- col-sm-12 -->
                        </div><!-- row -->
                    </fieldset>
                {/formContainer}
            </div>
        </div>

        <div class="row">
            <div class="col-sm-12">
                <div class="mb-3">
                    <label class="form-label" n:name="name">{_"form.form.name"}</label>
                    <input type="text" n:name="name" autofocus="autofocus" class="form-control">
                </div>
            </div><!-- col-sm-12 -->
        </div><!-- row -->

        <div class="row">
            <div class="col-sm-12">
                <div class="mb-3">
                    <label class="form-label" n:name="email">{_"form.form.sendToEmails"}</label>
                    <input n:name="email" class="form-control">
                </div>
            </div><!-- col-sm-12 -->
        </div><!-- row -->

        <div class="row">
            <div class="col-sm-12">
                <div class="mb-3">
                    <label class="form-label" n:name="hookUrl">{_"form.form.postDataToUrl"}</label>
                    <input n:name="hookUrl" class="form-control">
                </div>
            </div><!-- col-sm-12 -->
        </div><!-- row -->


        <div class="row">
            <div class="col-sm-12">
                <div class="form-check">
                    <label>
                        <input type="checkbox" n:name="isActive" class="form-check-input"> <span class="form-check-label">{_"form.form.isActive"}</span>
                    </label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="form-check">
                    <label>
                        <input type="checkbox" n:name="isAntispam" class="form-check-input"> <span class="form-check-label">{_"form.form.isAntispamProtected"}</span>
                    </label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="form-check">
                    <label>
                        <input type="checkbox" n:name="isSaveToDatabase" class="form-check-input"> <span class="form-check-label">{_"form.form.isSaveFormDataToDatabase"}</span>
                    </label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="form-check">
                    <label>
                        <input type="checkbox" n:name="isSendFormToDetectedEmail" class="form-check-input"> <span class="form-check-label">{_"form.form.isSendFormToDetectedEmail"}</span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer">
        <input type="submit" n:name="send" class="btn btn-success button" value="{_"form.global.save"}">
    </div>
</form>