extensions:
    dravencms.form: Dravencms\Form\DI\FormExtension

nettrine.orm:
    managers:
        default:
            mapping:
                DravencmsModelForm :
                    type: attributes
                    directories:
                        - %appDir%/../vendor/dravencms/form/src/Dravencms/Model/Form/Entities
                    namespace: Dravencms\Model\Form
